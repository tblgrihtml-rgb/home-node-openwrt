#!/bin/sh /etc/rc.common

START=94
STOP=10
USE_PROCD=1

PROG="/usr/libexec/homenode-health-monitor"

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env "HOMENODE_SYSTEM_HEALTH=/mnt/ssd/homenode/data/system-health.json" "HOMENODE_HEALTH_INTERVAL=60"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
