#!/bin/sh

set -eu

FULL_SELECTIONS="${VPN_DEVICES_PATH:-/mnt/ssd/homenode/data/vpn-devices}"
SMART_SELECTIONS="${VPN_SMART_DEVICES_PATH:-/mnt/ssd/homenode/data/vpn-smart-devices}"
SERVICE_NETWORKS="${VPN_ROUTED_NETWORKS_PATH:-/mnt/ssd/homenode/data/vpn-routed-networks-v4}"
LEASES="/tmp/dhcp.leases"
ROUTE_TABLE="51820"
MARK_PRIORITY="10050"
VPN_MARK="0x120000/0xff0000"
FIRST_PRIORITY="10100"
LAST_PRIORITY="10199"
NFT_FAMILY="inet"
NFT_TABLE="homenode_policy"
LAST_SIGNATURE=""

clear_rules() {
	# Remove every stale duplicate. A single `ip rule del` only removes one
	# matching rule and can leave another copy that makes the next add fail.
	while ip -4 rule del priority "$MARK_PRIORITY" 2>/dev/null; do :; done
	priority="$FIRST_PRIORITY"
	while [ "$priority" -le "$LAST_PRIORITY" ]; do
		while ip -4 rule del priority "$priority" 2>/dev/null; do :; done
		priority=$((priority + 1))
	done
}

ensure_nft_policy() {
	if nft list table "$NFT_FAMILY" "$NFT_TABLE" >/dev/null 2>&1; then
		return 0
	fi
	nft -f - <<'EOF'
add table inet homenode_policy
add set inet homenode_policy smart_clients { type ether_addr; }
add set inet homenode_policy full_clients { type ether_addr; }
add set inet homenode_policy service_v4 { type ipv4_addr; }
add set inet homenode_policy service_v6 { type ipv6_addr; }
add set inet homenode_policy service_networks_v4 { type ipv4_addr; flags interval; }
add chain inet homenode_policy prerouting { type filter hook prerouting priority mangle; policy accept; }
add rule inet homenode_policy prerouting iifname "br-lan" ether saddr @smart_clients meta nfproto ipv4 ip daddr @service_v4 meta mark set 0x120000 counter comment "HomeNode selected service DNS"
add rule inet homenode_policy prerouting iifname "br-lan" ether saddr @smart_clients meta nfproto ipv4 ip daddr @service_networks_v4 meta mark set 0x120000 counter comment "HomeNode selected service networks"
add rule inet homenode_policy prerouting iifname "br-lan" ether saddr @smart_clients meta nfproto ipv6 ip6 daddr @service_v6 counter drop comment "HomeNode force selected services to IPv4 VPN"
add rule inet homenode_policy prerouting iifname "br-lan" ether saddr @full_clients meta nfproto ipv6 counter drop comment "HomeNode prevent full VPN IPv6 leak"
EOF
}

flush_set() {
	nft flush set "$NFT_FAMILY" "$NFT_TABLE" "$1" 2>/dev/null || true
}

add_mac_set() {
	path="$1"
	set_name="$2"
	[ -r "$path" ] || return 0
	while IFS= read -r mac; do
		mac="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
		printf '%s\n' "$mac" | grep -Eq '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || continue
		nft add element "$NFT_FAMILY" "$NFT_TABLE" "$set_name" "{ $mac }"
	done < "$path"
}

load_service_networks() {
	[ -r "$SERVICE_NETWORKS" ] || return 0
	while IFS= read -r network; do
		network="${network%%#*}"
		network="$(printf '%s' "$network" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
		[ -n "$network" ] || continue
		printf '%s\n' "$network" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$' || continue
		nft add element "$NFT_FAMILY" "$NFT_TABLE" service_networks_v4 "{ $network }"
	done < "$SERVICE_NETWORKS"
}

apply_rules() {
	ensure_nft_policy
	clear_rules
	ip -4 route replace blackhole default metric 32767 table "$ROUTE_TABLE"
	ip -4 rule add priority "$MARK_PRIORITY" fwmark "$VPN_MARK" table "$ROUTE_TABLE"

	flush_set smart_clients
	flush_set full_clients
	flush_set service_networks_v4
	add_mac_set "$SMART_SELECTIONS" smart_clients
	add_mac_set "$FULL_SELECTIONS" full_clients
	load_service_networks

	[ -r "$FULL_SELECTIONS" ] || return 0
	[ -r "$LEASES" ] || return 0
	priority="$FIRST_PRIORITY"
	while IFS= read -r mac && [ "$priority" -le "$LAST_PRIORITY" ]; do
		mac="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
		printf '%s\n' "$mac" | grep -Eq '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || continue
		address="$(awk -v wanted="$mac" 'tolower($2) == wanted { print $3; exit }' "$LEASES")"
		printf '%s\n' "$address" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || continue
		ip -4 rule add priority "$priority" from "${address}/32" table "$ROUTE_TABLE"
		priority=$((priority + 1))
	done < "$FULL_SELECTIONS"
}

cleanup() {
	clear_rules
	flush_set smart_clients
	flush_set full_clients
}

trap 'cleanup; exit 0' INT TERM
trap cleanup EXIT

ensure_nft_policy
while :; do
	signature="$({ md5sum "$FULL_SELECTIONS" 2>/dev/null || true; md5sum "$SMART_SELECTIONS" 2>/dev/null || true; md5sum "$SERVICE_NETWORKS" 2>/dev/null || true; md5sum "$LEASES" 2>/dev/null || true; } | md5sum)"
	if [ "$signature" != "$LAST_SIGNATURE" ]; then
		apply_rules
		LAST_SIGNATURE="$signature"
	fi
	sleep 2
done
